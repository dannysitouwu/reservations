# Environment Variables Template

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vite (Admin & Client apps)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Expo (Mobile app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: API
API_BASE_URL=http://localhost:3000

# Stripe (test mode) — Expo user app web checkout (also set in app.json → expo.extra, then restart Expo)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Same value can go in app.json as EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY or VITE_STRIPE_PUBLISHABLE_KEY

# Supabase Edge Function `stripe-payment` secrets (Dashboard → Edge Functions)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...  (same as above; returned to client for Elements)
